# Application
APP_NAME=Voice-Fingerprint-Delivery-System
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/delivery_system
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for biometric data)
ENCRYPTION_KEY=your-encryption-key-32-bytes-long

# Voice Authentication
VOICE_SIMILARITY_THRESHOLD=0.80
MIN_VOICE_SAMPLES=3
MAX_VOICE_SAMPLES=5
VOICE_SAMPLE_DURATION=5

# AI Detection
AI_DETECTION_THRESHOLD=0.90
ENABLE_AI_DETECTION=True

# File Storage
AUDIO_STORAGE_PATH=../storage/audio_samples
MAX_AUDIO_SIZE_MB=10

# Twilio (for call integration)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_phone_number
